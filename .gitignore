# OS generated files
.DS_Store
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db
Thumbs.db
*.tmp

# Obsidian runtime & local workspace state
.obsidian/workspace.json
.obsidian/workspace-mobile.json
.obsidian/file-recovery/
.obsidian/plugins/recent-files-obsidian/data.json

# User daily notes, attachments, and private research notes
# (Kept in private vault, ignored in public template)
Daily/*
!Daily/.gitkeep
Attachments/*
!Attachments/.gitkeep

# Exclude private notes, keeping only the example project note
Notes/*
!Notes/Example Project.md

# AI scratchpads, proposals, and working documents
AI/Working/*
!AI/Working/.gitkeep
AI/Proposals/*
!AI/Proposals/.gitkeep
AI/Dreaming/Imports/*
!AI/Dreaming/Imports/.gitkeep
AI/Dreaming/Runs/*
!AI/Dreaming/Runs/README.md

# AI memory topics
AI/Memory/Topics/*
!AI/Memory/Topics/.gitkeep
